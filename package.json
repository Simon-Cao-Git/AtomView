{
	"name": "atomview",
	"displayName": "AtomView",
	"description": "Lightweight live atomic structure preview inside VS Code",
	"version": "0.3.1",
	"publisher": "PurunSimonCao",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/Simon-Cao-Git/AtomView.git"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"icon": "media/icon.png",
	"categories": [
		"Visualization"
	],
	"keywords": [
		"POSCAR",
		"VASP",
		"Gaussian",
		"SIESTA",
		"Quantum ESPRESSO"
    ],
	"activationEvents": [
		"onCommand:atomview.openPreview"
	],
	"main": "./out/extension.js",
	"contributes": {

		"commands": [
			{
				"command": "atomview.openPreview",
				"title": "Open AtomView Preview",
				"category": "AtomView",
				"icon": "$(open-preview)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "atomview.openPreview",
					"group": "navigation",
					"when": "resourceFilename =~ /.*[Pp][Oo][Ss][Cc][Aa][Rr].*/ || resourceFilename =~ /.*[Cc][Oo][Nn][Tt][Cc][Aa][Rr].*/ || resourceFilename =~ /.*[Xx][Dd][Aa][Tt][Cc][Aa][Rr].*/ || resourceExtname =~ /\\.[vV][aA][sS][pP]/ || resourceExtname =~ /\\.[iI][nN]/ || resourceExtname =~ /\\.[fF][dD][fF]/ || resourceExtname =~ /\\.[gG][jJ][fF]/"
				}
			]
		}

	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"@types/vscode-webview": "^1.57.0",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"three": "^0.184.0"
	}
}
